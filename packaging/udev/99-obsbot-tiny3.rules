# OBSBOT Tiny 3 series — udev rules.
#
# 1. Give the `video`/`uucp` groups access (standard for v4l + the cdc_acm
#    control serial), so t3ctl and t3-wb-guard run without root.
# 2. Cold-plug white-balance pin: UVC controls reset to firmware defaults on
#    unplug/power-cycle, and this camera's auto WB drowns in green-walled rooms.
#    Re-pin manual WB on plug-in. Setting a control (S_CTRL) does NOT start a
#    stream, so this does not keep the camera awake. Target temperature comes
#    from /etc/obsbot-tiny3/config (wb_temp), else t3ctl's 4000K default —
#    edit the config, not this rule.
#
# NOTE: installing this rule does nothing for an already-plugged camera. Replug,
# or: udevadm control --reload-rules && udevadm trigger --action=add --subsystem-match=video4linux
#
# Supported product IDs (Remo Tech, vendor 3564):
#   ff04 = OBSBOT Tiny 3 Lite (verified)
# Tiny 3 / Tiny 3 SE use other PIDs — add them here once known (see CONTRIBUTING).

ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="ff04", ATTR{index}=="0", TAG+="uaccess", GROUP="video", MODE="0660", RUN+="/usr/bin/t3ctl --device $devnode wb pin"

# The cdc_acm control serial (if a future transport uses it) — group access only.
SUBSYSTEM=="tty", ATTRS{idVendor}=="3564", ATTRS{idProduct}=="ff04", TAG+="uaccess", GROUP="uucp", MODE="0660"
