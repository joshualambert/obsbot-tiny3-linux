[Unit]
Description=OBSBOT Tiny 3 white-balance guard (re-pins manual WB when apps flip it to auto)
Documentation=https://github.com/joshlambert/obsbot-tiny3-linux
# The device may not exist yet at login; the guard polls for it, so no hard dep.

[Service]
Type=simple
ExecStart=/usr/bin/t3-wb-guard
Restart=always
RestartSec=5
# Hardening: this only needs to read /proc, watch /dev/video*, and issue V4L2
# ioctls — no network, no new privileges, no writes outside runtime dirs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
