[Unit]
Description=OBSBOT Tiny 3 white-balance guard (re-pins manual WB when apps flip it to auto)
Documentation=https://github.com/joshualambert/obsbot-tiny3-linux
# The device may not exist yet at login; the guard polls for it, so no hard dep.

[Service]
Type=simple
ExecStart=/usr/bin/t3-wb-guard
Restart=always
RestartSec=5
# Light hardening only. NoNewPrivileges is always safe. The mount-namespace
# sandbox directives (ProtectSystem/ProtectHome/…) are deliberately omitted:
# in a *user* unit they require unprivileged user namespaces, which some
# systems disable (kernel.unprivileged_userns_clone=0), and there they make the
# whole unit fail to start. The guard needs no filesystem writes anyway.
NoNewPrivileges=true

[Install]
WantedBy=default.target
